    {
      "parameters": {
        "jsCode": "// Junta os dois caminhos num campo so. O texto do audio vem do\n// Whisper; o de texto ja veio pronto do Normalizar.\nconst n = $(\"Normalizar\").first().json;\nconst t = $input.first().json;\nconst pergunta = (t.text ?? t.texto ?? \"\").trim();\n\nif (!pergunta) {\n  return [{ json: { ...n, pergunta: null, vazio: true } }];\n}\n\nreturn [{ json: { ...n, pergunta } }];"
      },
      "id": "merge",
      "name": "Pergunta final",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        0
      ]
