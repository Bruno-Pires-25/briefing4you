    {
      "parameters": {
        "jsCode": "// A Evolution manda varios eventos no mesmo webhook. Aqui reduzimos\n// tudo a um formato so, e decidimos cedo o que ignorar.\nconst e = $input.first().json;\nconst d = e.data ?? e;\nconst key = d.key ?? {};\nconst msg = d.message ?? {};\n\nconst remoteJid = key.remoteJid ?? \"\";\nconst telefone = remoteJid.split(\"@\")[0].replace(/[^0-9]/g, \"\");\n\n// fromMe: eco da propria resposta do bot. Sem isso ele conversa sozinho.\n// @g.us: grupo. Dado financeiro pessoal nao vai para grupo.\nconst ignorar =\n  key.fromMe === true ||\n  remoteJid.endsWith(\"@g.us\") ||\n  remoteJid.endsWith(\"@broadcast\") ||\n  !remoteJid.endsWith(\"@s.whatsapp.net\") ||\n  !telefone;\n\nconst textoDireto =\n  msg.conversation ??\n  msg.extendedTextMessage?.text ??\n  null;\n\nconst audio = msg.audioMessage ?? null;\n\nreturn [{ json: {\n  ignorar,\n  telefone,\n  remoteJid,\n  messageId: key.id ?? null,\n  tipo: audio ? \"audio\" : (textoDireto ? \"texto\" : \"outro\"),\n  texto: textoDireto,\n  duracaoAudio: audio?.seconds ?? null,\n} }];"
      },
      "id": "norm",
      "name": "Normalizar",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -520,
        0
      ]
    },
